<!-- replace "erb[loud]:contains('decidim_form_for')" -->

<% if Decidim::Sinergiacrm.override_login?(current_organization) %>
  <div class="flex justify-center mt-10">
    <button type="button" class="button button__xs button__transparent-primary" data-controller="toggle" data-toggle-toggle-value="session_new_user"><%= t("decidim.sinergiacrm.login.admin_access") %></button>
  </div>
<% end %>

<%= decidim_form_for(resource, namespace: "session", as: resource_name, url: session_path(resource_name), html: { hidden: Decidim::Sinergiacrm.override_login?(current_organization) }) do |f| %>
